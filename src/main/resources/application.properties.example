# Copy this file to application.properties and fill in your own values.
# application.properties is git-ignored and must never be committed.
#
# The connection string below is for a local MySQL 8.4 LTS server.
# sslMode=DISABLED and allowPublicKeyRetrieval=true keep a local development
# connection simple; a production server would use TLS instead.
#
# Keep the database name at the end: schema.sql creates vehicle_service_center.

db.url=jdbc:mysql://localhost:3306/vehicle_service_center?sslMode=DISABLED&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.username=root
db.password=change-me
